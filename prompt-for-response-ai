- Format: [akcja] (nawiasy kwadratowe), NIE *akcja* (asterówki)!

${moderationInstructions}`
}

/**
 * Wykrywa w wiadomości użytkownika prośbę o chwilę czasu/oczekiwanie
 * 
 * @param message - Treść wiadomości użytkownika
 * @returns Obiekt z informacją czy wykryto prośbę i przewidywanym czasem oczekiwania w ms
 * 
 * @example
 * detectWaitRequest("zaczekaj chwilę")
 * // => { isWaitRequest: true, waitDurationMs: 120000 }
 * 
 * detectWaitRequest("wrócę za 5 minut")
 * // => { isWaitRequest: true, waitDurationMs: 300000 }
 * 
 * detectWaitRequest("hej co tam?")
 * // => { isWaitRequest: false, waitDurationMs: 0 }
 */
export interface WaitRequestDetection {
  isWaitRequest: boolean;
  waitDurationMs: number;
  detectedPhrase?: string;
}

export const detectWaitRequest = (message: string): WaitRequestDetection => {
  if (!message || typeof message !== 'string') {
    return { isWaitRequest: false, waitDurationMs: 0 };
  }

  const normalizedMessage = message.toLowerCase().trim();
  const MAX_WAIT_TIME_MS = 600000; // 10 minut

  // Wzorce z konkretnymi czasami
  const timePatterns = [
    // Minuty
    { pattern: /(\d+)\s*min(ut|utę|uty|ut)?/i, multiplier: 60000 },
    // Sekundy
    { pattern: /(\d+)\s*sek(und|undę|undy|und)?/i, multiplier: 1000 },
    // Godziny
    { pattern: /(\d+)\s*(godz|godzin|godzinę|godziny)?/i, multiplier: 3600000 },
  ];

  // Sprawdź wzorce z konkretnymi czasami
  for (const { pattern, multiplier } of timePatterns) {
    const match = normalizedMessage.match(pattern);
    if (match) {
      const duration = parseInt(match[1]) * multiplier;
      // Ogranicz do maksymalnie 10 minut
      const cappedDuration = Math.min(duration, MAX_WAIT_TIME_MS);
      return {
        isWaitRequest: true,
        waitDurationMs: cappedDuration,
        detectedPhrase: match[0]
      };
    }
  }

  // Wzorce ogólne (bez konkretnego czasu)
  const generalWaitPhrases = [
    'zaczekaj',
    'poczekaj',
    'chwil',
    'moment',
    'sekundę',
    'sekund',
    'zaraz',
    'za chwilę',
    'za moment',
    'wrócę',
    'wracam',
    'odezwę się',
    'muszę na chwilę',
    'muszę odebrać',
    'muszę zrobić',
    'coś muszę',
    'dam znać',
    'daj mi',
    'zostaw mi',
    'nie mogę teraz',
    'zajęty',
    'zajęta',
    'brb', // be right back
    'afk', // away from keyboard
  ];

  // Sprawdź czy wiadomość zawiera którekolwiek z ogólnych zwrotów
  for (const phrase of generalWaitPhrases) {
    if (normalizedMessage.includes(phrase)) {
      // Dla ogólnych zwrotów ustalamy domyślny czas oczekiwania (2 minuty)
      return {
        isWaitRequest: true,
        waitDurationMs: 120000, // 2 minuty
        detectedPhrase: phrase
      };
    }
  }

  return { isWaitRequest: false, waitDurationMs: 0 };
}

export const SUGGESTION_PROMPT_SUFFIX = `
[SYSTEM INSTRUCTION: REPLY SUGGESTIONS]
You MUST generate 3 short Polish reply suggestions for the user at the END of your response.
Format strictly: [[SUGGESTIONS: ["Option 1", "Option 2", "Option 3"]]]
This is mandatory for every single response.
`;

export const extractSuggestions = (response: string): { cleanResponse: string; suggestions: string[] } => {
  // Regex seeks the START of the suggestions block.
  // Matches: [[SUGGESTIONS:, [SUGGESTIONS:, SUGGESTIONS: (case insensitive)
  // Captures everything after it until the end of the string ($)
  let cleanResponse = response;
  let suggestions: string[] = [];

  // 1. Najpierw usuń tagi MEDIA_REQUEST (nawet jeśli niedomknięte) i inne potencjalne systemowe tagi
  // Regex: [[MEDIA_REQUEST: ... do ]] LUB do końca stringa
  const mediaRequestRegex = /(\[+)?\s*MEDIA_REQUEST\s*:\s*([\s\S]*?)(\]\]|$)/gi;
  cleanResponse = cleanResponse.replace(mediaRequestRegex, '');

  // 2. Teraz logika dla SUGGESTIONS (jak wcześniej)
  // Regex seeks the START of the suggestions block.
  // Matches: [[SUGGESTIONS:, [SUGGESTIONS:, SUGGESTIONS: (case insensitive)
  // Captures everything after it until the end of the string ($)
  const suggestionsMarkerRegex = /(\[+)?\s*SUGGESTIONS?\s*:\s*/i;

  const match = cleanResponse.match(suggestionsMarkerRegex);

  if (match && match.index !== undefined) {
    // 1. Zidentyfikuj początek tagu
    const markerIndex = match.index;

    // 2. Oddziel czystą odpowiedź (wszystko PRZED znacznikiem)
    // WAŻNE: Używamy cleanResponse, bo markerIndex pochodzi z match na cleanResponse!
    // create a temporary variable to hold the full string for extraction before we truncate cleanResponse
    const fullStringWithSuggestions = cleanResponse;
    cleanResponse = fullStringWithSuggestions.substring(0, markerIndex).trim();

    // 3. Pobierz resztę tekstu (wszystko PO znaczniku) do analizy JSON
    let contentAfterMarker = fullStringWithSuggestions.substring(markerIndex + match[0].length);

    // 4. Szukaj tablicy JSON [...]
    const firstBracket = contentAfterMarker.indexOf('[');

    if (firstBracket !== -1) {
      // Pobierz wszystko od pierwszego nawiasu [ do końca
      const jsonCandidate = contentAfterMarker.substring(firstBracket);

      // Strategia "Backtracking":
      // AI często zwraca `["A", "B"]]]` (bo zamyka tag).
      // JSON.parse wyrzuci błąd dla `["A"]]]`.
      // Dlatego szukamy ostatniego `]`, próbujemy sparsować. Jak błąd -> szukamy przedostatniego `]`, itd.

      let endBracketIndex = jsonCandidate.lastIndexOf(']');

      while (endBracketIndex !== -1) {
        const potentialJson = jsonCandidate.substring(0, endBracketIndex + 1);

        try {
          const parsed = JSON.parse(potentialJson);
          if (Array.isArray(parsed)) {
            suggestions = parsed;
            // Znaleźliśmy poprawny JSON, przerywamy pętlę
            break;
          }
        } catch (e) {
          // Błąd parsowania - to nie był ten nawias. Szukamy wcześniejszego.
          // Ignorujemy błąd, próbujemy dalej.
        }

        // Szukaj kolejnego (wcześniejszego) nawiasu zamykającego
        endBracketIndex = jsonCandidate.lastIndexOf(']', endBracketIndex - 1);
      }
    }
  }

  // Cleanup: usuń ewentualne śmieci z końca czystej odpowiedzi (np. samotny nawias] zostawiony przez złe formatowanie)
  // Cleanup: usuń ewentualne śmieci z końca czystej odpowiedzi
  // 1. Usunięcie samotnych nawiasów zamykających (np. "]]")
  cleanResponse = cleanResponse.replace(/\]+$/, '');

  // 2. Usunięcie "wiszących" początków tagów na samym końcu wiadomości
  // Jeśli wiadomość kończy się na "[[", "[[MEDIA", "[[SUGG" itp. - usuń to.
  // Zakładamy, że AI nie powinna kończyć zdania nawiasem "[[".
  cleanResponse = cleanResponse.replace(/\[\[[\w\s]*$/, '');

  cleanResponse = cleanResponse.trim();

  return { cleanResponse, suggestions };
};
