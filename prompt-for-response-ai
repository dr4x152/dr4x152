// Funkcja do konwersji Base64 na surowe dane binarne
export const base64ToRawBinary = (base64: string): { data: Uint8Array; contentType: string } => {
  const parts = base64.split(';base64,')
  const contentType = parts[0].split(':')[1]
  const raw = window.atob(parts[1])
  const rawLength = raw.length
  const data = new Uint8Array(rawLength)

  for (let i = 0; i < rawLength; ++i) {
    data[i] = raw.charCodeAt(i)
  }

  return { data, contentType }
}

// Funkcja do konwersji Base64 na Blob (zachowana dla kompatybilności wstecznej)
export const base64ToBlob = (base64: string) => {
  const { data, contentType } = base64ToRawBinary(base64)
  return new Blob([data.buffer as ArrayBuffer], { type: contentType })
}

// Funkcja analizy zdjęcia
export const analyzeImage = async (imageUrl: string, openai: any, supabase: any): Promise<string> => {
  console.log('📸 Rozpoczęcie analizy zdjęcia')

  // Sprawdź czy URL zdjęcia nie jest pusty
  if (!imageUrl || imageUrl === '') {
    console.log('⚠️ Pusty URL zdjęcia - pomijam analizę')
    return 'Nie udało się przeanalizować zdjęcia'
  }

  // Sprawdź czy URL ma poprawny format base64 lub http
  if (!imageUrl.startsWith('data:image/') && !imageUrl.startsWith('http')) {
    console.log('⚠️ Niepoprawny format URL zdjęcia - pomijam analizę')
    return 'Niepoprawny format zdjęcia'
  }

  try {
    const { data: settingsData, error: settingsError } = await supabase
      .from('settings')
      .select('image_interpretation_prompt')
      .limit(1);

    if (settingsError) {
      console.error('❌ Błąd podczas pobierania ustawień promptu:', settingsError);
    }

    // Użyj domyślnego promptu jeśli nie znaleziono niestandardowego
    const promptText = (settingsData && settingsData.length > 0 && settingsData[0].image_interpretation_prompt) ||
      "Opisz krótko co widzisz na tym zdjęciu (max 2 zdania)";

    const completion = await openai.chat.completions.create({
      model: "gpt-4-turbo",
      messages: [{
        role: "user",
        content: [
          { type: "text", text: promptText },
          { type: "image_url", image_url: { url: imageUrl, detail: "low" } }
        ]
      }],
      max_tokens: 100
    })
    return completion.choices[0].message.content || ''
  } catch (error) {
    console.error('❌ Błąd analizy zdjęcia:', error)
    return 'Nie udało się przeanalizować zdjęcia'
  }
}

// Funkcja pomocnicza do sprawdzania, czy ścieżka jest pełnym URL czy tylko ścieżką do zdjęcia
export const isFullUrl = (path: string): boolean => {
  return path.startsWith('http://') || path.startsWith('https://');
}

